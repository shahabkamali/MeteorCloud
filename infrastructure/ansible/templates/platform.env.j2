APP_NAME=edge-platform
APP_ENV={{ platform_env }}
APP_SECRET_KEY={{ lookup('env', 'APP_SECRET_KEY') | default(lookup('env', 'EDGE_PLATFORM_JWT_SECRET'), true) }}

DATABASE_URL=postgresql+psycopg://{{ postgres_username }}:{{ lookup('env', 'EDGE_PLATFORM_POSTGRES_PASSWORD') }}@postgres:5432/{{ postgres_database }}
POSTGRES_USER={{ postgres_username }}
POSTGRES_PASSWORD={{ lookup('env', 'EDGE_PLATFORM_POSTGRES_PASSWORD') }}
POSTGRES_DB={{ postgres_database }}

REDIS_URL=redis://{% if lookup('env', 'EDGE_PLATFORM_REDIS_PASSWORD') %}:{{ lookup('env', 'EDGE_PLATFORM_REDIS_PASSWORD') }}@{% endif %}redis:6379/0

JWT_SECRET_KEY={{ lookup('env', 'EDGE_PLATFORM_JWT_SECRET') }}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

BACKEND_CORS_ORIGINS={{ platform_public_url }}
VITE_API_BASE_URL={{ platform_public_url }}

PLATFORM_VERSION={{ platform_version }}
EDGE_PLATFORM_ADMIN_EMAIL={{ lookup('env', 'EDGE_PLATFORM_ADMIN_EMAIL') | default('', true) }}
EDGE_PLATFORM_ADMIN_PASSWORD={{ lookup('env', 'EDGE_PLATFORM_ADMIN_PASSWORD') | default('', true) }}
